<%- include('partials/header') %>

<div class="breadcrumb"><a href="/">工标网</a> <span class="cur">› 新标准</span></div>

<div class="page-head">
  <h1>新标准</h1>
  <p class="sub">按分类查看最新发布的标准。</p>
</div>

<% if (!ccsGroups.length && !indGroups.length) { %>
  <p class="empty">暂无数据。</p>
<% } %>

<% ccsGroups.forEach((g) => { %>
  <div class="section">
    <div class="section-head">
      <h2><%= g.code %> <%= g.name %></h2>
      <a href="/category/ccs/<%= g.code %>" class="more">该分类全部 ›</a>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>标准编号</th><th>标准名称</th><th class="num">状态</th></tr></thead>
        <tbody>
          <% g.items.forEach((s) => { %>
            <tr>
              <td class="std-num"><a href="/standard/<%= s.id %>"><%= s.std_number %></a></td>
              <td class="title"><a href="/standard/<%= s.id %>"><%= s.title %></a></td>
              <td class="num"><span class="status status-<%= s.status %>"><%= s.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>

<% indGroups.forEach((g) => { %>
  <div class="section">
    <div class="section-head">
      <h2><%= g.code %> <%= g.name %></h2>
      <a href="/category/industry/<%= g.code %>" class="more">该分类全部 ›</a>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>标准编号</th><th>标准名称</th><th class="num">状态</th></tr></thead>
        <tbody>
          <% g.items.forEach((s) => { %>
            <tr>
              <td class="std-num"><a href="/standard/<%= s.id %>"><%= s.std_number %></a></td>
              <td class="title"><a href="/standard/<%= s.id %>"><%= s.title %></a></td>
              <td class="num"><span class="status status-<%= s.status %>"><%= s.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>

<%- include('partials/footer') %>
