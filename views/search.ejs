<%- include('partials/header') %>

<%
  // 拼接查询串（过滤空值）
  function qs(params) {
    var parts = [];
    for (var k in params) {
      var v = params[k];
      if (v !== undefined && v !== null && v !== '') parts.push(k + '=' + encodeURIComponent(v));
    }
    return parts.length ? '?' + parts.join('&') : '';
  }
  var statusCounts = {};
  (statusStats || []).forEach(function (s) { statusCounts[s.status] = s.c; });
%>

<div class="breadcrumb"><a href="/">工标网</a> <span class="cur">› <%= isNotice ? '公告搜索' : '标准搜索' %></span></div>

<div class="page-head">
  <h1><%= isNotice ? '公告搜索' : (q.keyword || '标准搜索') %></h1>
  <p class="sub">共找到 <span class="num"><%= result.total.toLocaleString('zh-CN') %></span> 条<%= isNotice ? '公告' : '标准' %></p>
</div>

<% if (isNotice) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>公告标题</th><th class="num">发布时间</th></tr></thead>
      <tbody>
        <% result.rows.forEach((r) => { %>
          <tr>
            <td class="title"><a href="/announcement/<%= r.id %>"><%= r.title %></a></td>
            <td class="date"><%= r.publish_date %></td>
          </tr>
        <% }) %>
        <% if (!result.rows.length) { %>
          <tr><td class="empty" colspan="2">未找到相关公告，请更换关键词。</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="count-cards">
    <a href="/search<%= qs(Object.assign({}, q, { status: '' })) %>" class="count-card <%= !q.status ? 'on' : '' %>">
      <b><%= result.total.toLocaleString('zh-CN') %></b><span>全部</span>
    </a>
    <% statuses.forEach((st) => { %>
      <a href="/search<%= qs(Object.assign({}, q, { status: st })) %>" class="count-card <%= q.status === st ? 'on' : '' %>">
        <b><%= (statusCounts[st] || 0).toLocaleString('zh-CN') %></b><span><%= st %></span>
      </a>
    <% }) %>
  </div>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>标准编号</th><th>标准名称</th><th class="num">状态</th></tr>
      </thead>
      <tbody>
        <% result.rows.forEach((s) => { %>
          <tr>
            <td class="std-num"><a href="/standard/<%= s.id %>"><%= s.std_number %></a></td>
            <td class="title"><a href="/standard/<%= s.id %>"><%= s.title %></a></td>
            <td class="num"><span class="status status-<%= s.status %>"><%= s.status %></span></td>
          </tr>
        <% }) %>
        <% if (!result.rows.length) { %>
          <tr><td class="empty" colspan="3">未找到相关标准，请更换关键词重试。</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (result.page > 1) { %>
      <a href="/<%= isNotice ? 'notice' : 'search' %><%= qs(Object.assign({}, q, { sort: sortIdx, way: way, page: result.page - 1 })) %>">上一页</a>
    <% } %>
    <span>第 <%= result.page %> / <%= totalPages %> 页</span>
    <% if (result.page < totalPages) { %>
      <a href="/<%= isNotice ? 'notice' : 'search' %><%= qs(Object.assign({}, q, { sort: sortIdx, way: way, page: result.page + 1 })) %>">下一页</a>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
