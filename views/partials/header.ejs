<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '工标网 · 标准查询' %></title>
  <meta name="description" content="工标网——标准查询门户，收录 6 万余条国家标准与行业标准，支持按编号、名称、分类检索浏览，含公告与动态。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=13">
</head>
<body class="<%= path === '/' ? 'home' : '' %>">

<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand">
      <span class="brand-mark">工</span>
      <span class="brand-name">工标网</span>
    </a>
    <nav class="nav" aria-label="主导航">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">首页</a>
      <a href="/category" class="<%= path.startsWith('/category') ? 'active' : '' %>">分类</a>
      <a href="/new" class="<%= path === '/new' ? 'active' : '' %>">新标准</a>
      <a href="/announcement" class="<%= path.startsWith('/announcement') ? 'active' : '' %>">公告</a>
      <a href="/news" class="<%= path.startsWith('/news') ? 'active' : '' %>">动态</a>
      <a href="/advanced" class="<%= path === '/advanced' ? 'active' : '' %>">高级查询</a>
    </nav>
    <div class="topbar-tools">
      <form method="get" action="/search" class="search-compact">
        <input type="text" name="keyword" placeholder="标准编号 / 名称" aria-label="搜索标准" value="<%= typeof q !== 'undefined' ? q.keyword || '' : '' %>">
        <button type="submit">搜索</button>
      </form>
    </div>
  </div>
</header>

<main class="sheet">
  <div class="wrap">
